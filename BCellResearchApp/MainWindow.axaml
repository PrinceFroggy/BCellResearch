<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BCellResearchApp.MainWindow"
        Title="B-Cell Memory Research Workbench"
        Width="1280" Height="820" MinWidth="1040" MinHeight="680">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="IMMUNE RESEARCH TOOLING"/>
        <TextBlock Text="B-Cell Memory Research Workbench" FontSize="30" FontWeight="Bold"/>
        <TextBlock Classes="muted" Text="Candidate annotation, public evidence review, workflow validation, and dry-run equipment simulation." FontSize="14"/>
      </StackPanel>
      <Border Grid.Column="1" Classes="cardSoft" Padding="14,10" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="9" Height="9" CornerRadius="5" Background="#22C55E" VerticalAlignment="Center"/>
          <TextBlock Text="Research mode" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Classes="notice" Margin="0,0,0,18">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="30" Height="30" CornerRadius="15" Background="#173B5C" VerticalAlignment="Top">
          <TextBlock Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#7DD3FC"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
          <TextBlock Text="Research safety boundary" FontWeight="SemiBold" Foreground="#BAE6FD"/>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="This application is for research annotation and simulation only. It does not diagnose, prescribe treatment, erase immune memory, select cells for destruction, or directly control medical/laboratory equipment."/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="2">
      <TabItem Header="Clone Analysis">
        <Grid ColumnDefinitions="360,*" RowDefinitions="Auto,*" Margin="0,16,0,0">
          <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="cardSoft" Margin="0,0,0,14" Padding="12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <Button x:Name="LoadDemoButton" Content="Load demo" Click="LoadDemo_Click"/>
              <Button Grid.Column="1" Margin="9,0,0,0" x:Name="OpenCsvButton" Content="Open CSV…" Click="OpenCsv_Click"/>
              <Button Grid.Column="2" Margin="9,0,0,0" Classes="primary" x:Name="EnrichButton" Content="Query IEDB evidence" Click="Enrich_Click"/>
              <TextBlock Grid.Column="3" x:Name="StatusText" Classes="muted" VerticalAlignment="Center" Margin="19,0,10,0" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="4" Margin="9,0,0,0" Text="CANDIDATES" Classes="eyebrow" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0,0,14,0">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Margin="0,0,0,12" Spacing="3">
                <TextBlock Classes="sectionTitle" Text="Clone library"/>
                <TextBlock Classes="muted" Text="Select a candidate to review its evidence and workflow state." TextWrapping="Wrap"/>
              </StackPanel>
              <ListBox Grid.Row="1" x:Name="CloneList" SelectionChanged="CloneList_SelectionChanged"/>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Classes="card">
            <ScrollViewer>
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="eyebrow" Text="SELECTED ASSESSMENT"/>
                    <TextBlock x:Name="DetailClone" FontSize="24" FontWeight="Bold"/>
                  </StackPanel>
                  <Border Grid.Column="1" Classes="cardSoft" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailClass" FontWeight="SemiBold" Foreground="#93C5FD"/>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                  <Border Classes="cardSoft">
                    <StackPanel Spacing="7">
                      <TextBlock Classes="eyebrow" Text="ANTIGEN"/>
                      <TextBlock x:Name="DetailAntigen" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="cardSoft" Margin="12,0,0,0">
                    <StackPanel Spacing="7">
                      <TextBlock Classes="eyebrow" Text="SCORE"/>
                      <TextBlock x:Name="DetailScore" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="cardSoft">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Text="EVIDENCE"/>
                    <TextBlock x:Name="DetailEvidence" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailRationale" TextWrapping="Wrap" Classes="muted"/>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                  <TextBlock Classes="sectionTitle" Text="Research workflow"/>
                  <TextBlock x:Name="WorkflowStageText" TextWrapping="Wrap"/>
                  <TextBlock x:Name="WorkflowNotesText" TextWrapping="Wrap" Classes="muted"/>
                </StackPanel>

                <Border Classes="cardSoft">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="REVIEW ACTIONS"/>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Validate evidence" Click="ValidateEvidence_Click" Margin="0,0,8,8"/>
                      <Button Content="Risk gate" Click="RiskGate_Click" Margin="0,0,8,8"/>
                      <TextBox x:Name="ReviewerName" Width="185" Watermark="Reviewer name" Margin="0,0,8,8"/>
                      <Button Classes="success" Content="Approve research" Click="ApproveResearch_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Run sandbox simulation" Click="RunSimulation_Click" Margin="0,0,8,0"/>
                      <Button Classes="primary" Content="Export candidate report…" Click="ExportReport_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="7">
                  <TextBlock Classes="eyebrow" Text="ANTIBODY SEQUENCE"/>
                  <TextBox x:Name="DetailSequence" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" FontFamily="Menlo,Consolas,Courier New"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Public API Explorer">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
          <Border Classes="card" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox x:Name="ApiSequence" Watermark="Antigen/epitope amino-acid sequence (e.g. SIINFEKL)"/>
              <Button Grid.Column="1" Margin="9,0,0,0" Classes="primary" Content="IEDB sequence search" Click="IedbSequence_Click"/>
              <Button Grid.Column="2" Margin="9,0,0,0" Content="Sample BCR records" Click="IedbBcr_Click"/>
            </Grid>
          </Border>
          <TextBlock Grid.Row="1" x:Name="ApiStatus" Classes="muted" Margin="4,0,0,10" TextWrapping="Wrap"/>
          <Border Grid.Row="2" Classes="card" Padding="0">
            <TextBox x:Name="ApiOutput" Background="Transparent" BorderThickness="0" Padding="16" FontFamily="Menlo,Consolas,Courier New" AcceptsReturn="True" TextWrapping="NoWrap" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Equipment Digital Twin">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,16,0,0">
          <Border Classes="card" Margin="0,0,0,14">
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="SIMULATED INTEGRATION"/>
              <TextBlock Text="Medical / Lab Equipment Digital Twin" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock x:Name="EquipmentProfileText" TextWrapping="Wrap"/>
              <TextBlock Classes="muted" Text="The adapter behaves like an equipment connection while producing only non-executable dry-run envelopes." TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Classes="primary" Content="Connect" Click="EquipmentConnect_Click" Margin="0,0,8,8"/>
            <Button Content="Disconnect" Click="EquipmentDisconnect_Click" Margin="0,0,8,8"/>
            <Button Content="Toggle interlock" Click="EquipmentInterlock_Click" Margin="0,0,8,8"/>
            <Button Content="Submit selected candidate" Click="EquipmentSubmit_Click" Margin="0,0,8,8"/>
            <Button Content="Advance selected job" Click="EquipmentAdvance_Click" Margin="0,0,8,8"/>
            <Button Content="Export audit…" Click="EquipmentExport_Click" Margin="0,0,8,8"/>
          </WrapPanel>
          <Border Grid.Row="2" Classes="cardSoft" Margin="0,0,0,14">
            <StackPanel Spacing="6">
              <TextBlock x:Name="EquipmentStateText" FontWeight="SemiBold"/>
              <TextBlock x:Name="EquipmentStatus" TextWrapping="Wrap" Classes="muted"/>
              <TextBlock x:Name="EquipmentTelemetryText" TextWrapping="Wrap" FontFamily="Menlo,Consolas,Courier New"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Classes="card">
            <ListBox x:Name="EquipmentJobs"/>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="BD Flow Cytometry">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
          <Border Classes="card" Margin="0,0,0,14">
            <StackPanel Spacing="6">
              <TextBlock Classes="eyebrow" Text="FLOW CYTOMETRY"/>
              <TextBlock Text="BD Flow Cytometry Integration" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="Import standard FCS 3.x cytometry files from BD and other instruments. Real device control remains disabled because no verified public FACSDiscover S8 control API is configured." TextWrapping="Wrap"/>
              <TextBlock x:Name="BdProfileText" TextWrapping="Wrap" Classes="muted"/>
            </StackPanel>
          </Border>
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Classes="primary" Content="Open FCS file…" Click="BdOpenFcs_Click" Margin="0,0,8,8"/>
            <Button Content="Show integration status" Click="BdStatus_Click" Margin="0,0,8,8"/>
            <TextBox x:Name="BdVendorEndpoint" Width="380" Watermark="Official BD/Biosero endpoint (optional)" Margin="0,0,8,8"/>
            <Button Content="Validate endpoint" Click="BdValidateEndpoint_Click" Margin="0,0,8,8"/>
          </WrapPanel>
          <Border Grid.Row="2" Classes="card" Padding="0">
            <TextBox x:Name="BdOutput" Background="Transparent" BorderThickness="0" Padding="16" FontFamily="Menlo,Consolas,Courier New" AcceptsReturn="True" TextWrapping="NoWrap" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Architecture &amp; Safety">
        <ScrollViewer Margin="0,16,0,0">
          <StackPanel Spacing="14" MaxWidth="940" HorizontalAlignment="Left">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="eyebrow" Text="SYSTEM PIPELINE"/>
                <TextBlock Text="Architecture &amp; Safety" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="CSV / repertoire metadata → C++ native scoring → IEDB evidence → validation → research risk gate → human approval → equipment digital twin → dry-run queue / telemetry / interlocks → audit and report export" FontSize="16" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Classes="cardSoft">
              <TextBlock Text="The public-data layer cannot trigger biological intervention. A candidate label means “worth research review,” not “confirmed SARS-CoV-2 memory cell.”" TextWrapping="Wrap"/>
            </Border>
            <Border Classes="cardSoft">
              <TextBlock Classes="muted" Text="For serious research, replace metadata heuristics with validated repertoire pipelines, experimental binding assays, lineage analysis, provenance, blinded validation, privacy controls, and institutional/regulatory oversight." TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
