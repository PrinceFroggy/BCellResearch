<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BCellResearchApp.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#0B1020"/>
      <Setter Property="FontFamily" Value="Inter"/>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF9"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8FA0BA"/>
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#7DD3FC"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.4"/>
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#11182A"/>
      <Setter Property="BorderBrush" Value="#243149"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="Border.cardSoft">
      <Setter Property="Background" Value="#0E1526"/>
      <Setter Property="BorderBrush" Value="#1E2A41"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#10243A"/>
      <Setter Property="BorderBrush" Value="#1D4F73"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#172238"/>
      <Setter Property="Foreground" Value="#EEF5FF"/>
      <Setter Property="BorderBrush" Value="#2A3A57"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#3B82F6"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.success">
      <Setter Property="Background" Value="#0F5132"/>
      <Setter Property="BorderBrush" Value="#1A7F52"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0C1323"/>
      <Setter Property="Foreground" Value="#E7EDF8"/>
      <Setter Property="BorderBrush" Value="#2A3851"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="11,9"/>
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#0F1728"/>
    </Style>

    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#173A68"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="#A9B7CC"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </Application.Styles>
</Application>
